#!/usr/bin/env bash
# ESP-IDF 5.4.3 w Dockerze (decyzja D-1, firmware 6.2-s1): obraz espressif/idf:v5.4.3, ten sam wzorzec co scripts/egrlab-docker.
# Komputer 24/7 jest rejestratorem monitoringu (docs/UBUNTU-24-7.md): najniższa waga CPU (Frigate ma domyślne 1024) i limit rdzeni;
# EGRLAB_CPUS=0 zdejmuje limit. Katalog bieżący i repozytorium montowane pod tą samą ścieżką; bez sieci (projekt nie pobiera komponentów).
#   scripts/egrlab-idf idf.py -B build-logger -DSDKCONFIG=sdkconfig.logger "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.logger.defaults" build
set -euo pipefail
IMAGE="${EGRLAB_IDF_IMAGE:-espressif/idf:v5.4.3}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIMITS=(--cpu-shares "${EGRLAB_CPU_SHARES:-2}")
if [ "${EGRLAB_CPUS:-2}" != 0 ]; then LIMITS+=(--cpus "${EGRLAB_CPUS:-2}"); fi
MOUNTS=(-v "$REPO:$REPO")
case "$PWD/" in "$REPO"/*) ;; *) MOUNTS+=(-v "$PWD:$PWD") ;; esac
for d in ${EGRLAB_EXTRA_MOUNTS:-}; do MOUNTS+=(-v "$d:$d"); done   # np. katalogi build poza repozytorium
TTY=(-i); [ -t 0 ] && [ -t 1 ] && TTY=(-it)
exec docker run --rm "${TTY[@]}" "${LIMITS[@]}" --network none --user "$(id -u):$(id -g)" -e HOME=/tmp/idf-home \
  -e IDF_COMPONENT_MANAGER=0 "${MOUNTS[@]}" -w "$PWD" "$IMAGE" "$@"
