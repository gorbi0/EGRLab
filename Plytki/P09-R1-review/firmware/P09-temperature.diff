--- a/firmware/main/board.c
+++ b/firmware/main/board.c
@@ -272,7 +272,8 @@
     #if CONFIG_EGR_TEMP_PRESENT
     for (int i = 0; i < 2; i++) {
         spi_device_interface_config_t t = {.clock_speed_hz = 1000000, .mode = 1,
-            .spics_io_num = i ? 16 : 8, .queue_size = 1};
+            .spics_io_num = i ? 16 : 8, .queue_size = 1,
