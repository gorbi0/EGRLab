(version 1)
(rule "S1 tor >= 0.30 mm poza drobnym rastrem"
  (condition "A.Type == 'Track' && !(A.intersectsCourtyard('U1') || A.intersectsCourtyard('U3'))")
  (constraint track_width (min 0.30mm)))
(rule "drobny raster U1 / U3: tor >= 0.20 mm"
  (condition "A.Type == 'Track' && (A.intersectsCourtyard('U1') || A.intersectsCourtyard('U3'))")
  (constraint track_width (min 0.20mm)))
(rule "drobny raster U1 / U3: odstep 0.15 mm miedzy elementami w obrysie ukladu (bez wylewek)"
  (condition "A.Type != 'Zone'")
  (constraint clearance (min 0.15mm)))
(rule "drobny raster U1 / U3: wylewka 0.15 mm tylko do miedzi calej w pierscieniu padow"
  (condition "A.Type == 'Zone' && (B.enclosedByArea('DRC_ONLY_U1') || B.enclosedByArea('DRC_ONLY_U3'))")
  (constraint clearance (min 0.15mm)))
